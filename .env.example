# =============================================================================
# NexusOne Agent Service - environment reference
# Copy to `.env` and edit. Every variable is listed with the store/provider it
# applies to. Variables marked REQUIRED have no usable default.
# =============================================================================

# -----------------------------------------------------------------------------
# Application                                                        [always]
# -----------------------------------------------------------------------------
APP_NAME=agent-service
ENVIRONMENT=local                  # local | dev | staging | production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                      # false for human readable logs in a terminal
# Serve /docs, /redoc and /openapi.json.
# Unset -> true everywhere except ENVIRONMENT=production.
ENABLE_DOCS=true
CORS_ORIGINS=*                     # comma separated list of allowed origins

# -----------------------------------------------------------------------------
# Security - JWT                                                     [always]
# -----------------------------------------------------------------------------
# REQUIRED. Shared HMAC secret used by the calling backend to sign tokens.
# Must be at least 32 characters - the service refuses to start otherwise.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256                # HS256 | HS384 | HS512 ('none' is always rejected)
JWT_ISSUER=                        # optional; when set, 'iss' must match
JWT_AUDIENCE=                      # optional; when set, 'aud' must match
JWT_LEEWAY_SECONDS=30              # clock skew tolerance for exp/nbf/iat

# -----------------------------------------------------------------------------
# Knowledge base domains                                             [always]
# -----------------------------------------------------------------------------
# Adding a domain is a config change only - no code, no migration.
KB_DOMAINS=hr,finance,engineering,it,company
# Always eligible for general questions when the token can read it.
KB_FALLBACK_DOMAIN=company

# Multi-tenancy. The tenant is read from the JWT 'tenant_id' claim, never the body.
#   off      - single tenant
#   metadata - one shared collection per domain, every chunk carries tenant_id
#   prefix   - physical separation: kb_<tenant>_<domain>
TENANT_MODE=off
DEFAULT_TENANT_ID=                 # fallback tenant when the token omits the claim

# -----------------------------------------------------------------------------
# Vector store selection                                             [always]
# -----------------------------------------------------------------------------
VECTOR_STORE=chroma                # chroma | faiss | pinecone
COLLECTION_PREFIX=kb               # physical names are <prefix>_<domain>

# --- Chroma -----------------------------------------------------------[chroma]
# Embedded persistent client (default). Ignored when CHROMA_HOST is set.
CHROMA_PERSIST_DIR=./data/chroma
# Remote Chroma server. Set CHROMA_HOST to switch from embedded to HTTP client.
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_SSL=false

# --- FAISS -------------------------------------------------------------[faiss]
# Root directory; one sub-directory per domain, saved after every mutation and
# loaded again on startup.
FAISS_INDEX_PATH=./data/faiss

# --- Pinecone -------------------------------------------------------[pinecone]
PINECONE_API_KEY=                  # REQUIRED when VECTOR_STORE=pinecone
PINECONE_INDEX=                    # REQUIRED when PINECONE_STRATEGY=namespace
PINECONE_STRATEGY=namespace        # namespace (shared index) | index (one index per domain)
PINECONE_NAMESPACE=                # optional prefix applied to every namespace
PINECONE_AUTO_CREATE=false         # create serverless indexes automatically
PINECONE_CLOUD=aws                 # serverless spec, used when auto-creating
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# -----------------------------------------------------------------------------
# LLM provider                                                        [always]
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai                # openai | anthropic | fake (offline, deterministic)
LLM_MODEL=gpt-4o-mini              # anthropic example: claude-3-5-sonnet-latest
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

OPENAI_API_KEY=                    # REQUIRED for LLM_PROVIDER/EMBEDDING_PROVIDER=openai
OPENAI_BASE_URL=                   # optional; Azure/proxy/self-hosted OpenAI-compatible endpoint
ANTHROPIC_API_KEY=                 # REQUIRED for LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Embedding provider                                                  [always]
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai          # openai | huggingface | fake
EMBEDDING_MODEL=text-embedding-3-small
# Optional override / expected dimension. Validated against the store; a
# mismatch fails fast with a pointer to POST /kb/{domain}/reindex.
EMBEDDING_DIMENSION=
HUGGINGFACE_DEVICE=cpu             # cpu | cuda | mps            [huggingface]

# -----------------------------------------------------------------------------
# Ingestion and retrieval                                             [always]
# -----------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150                  # must be smaller than CHUNK_SIZE
EMBED_BATCH_SIZE=64
MAX_UPLOAD_BYTES=26214400          # 25 MiB per file
RETRIEVAL_K=5
RRF_K=60                           # reciprocal rank fusion constant
# More sources than this in one request -> queued as a background job.
BACKGROUND_INGEST_THRESHOLD=2

# -----------------------------------------------------------------------------
# Agent                                                               [always]
# -----------------------------------------------------------------------------
AGENT_MAX_TOOL_ITERATIONS=4
AGENT_CHECKPOINTER=memory          # memory | none (swap for Postgres/Redis in prod)
# AGENT_SYSTEM_PROMPT=You are the NexusOne ERP assistant. ...

# -----------------------------------------------------------------------------
# Resilience (tenacity retry/backoff for embedding and LLM calls)     [always]
# -----------------------------------------------------------------------------
RETRY_ATTEMPTS=3
RETRY_INITIAL_SECONDS=0.5
RETRY_MAX_SECONDS=8.0
